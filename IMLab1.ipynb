    "\n",
    "\n",
    "x = 0.2152\n",
    "for i in range(1, 101):\n",
    "    x = x**2\n",
    "    num = f\"{x:.8f}\"\n",
    "    num = num[4:8]\n",
    "    x = float(num)/10000\n",
    "    x_2 = x**2\n",
    "    x_2 = round(x_2, 8)\n",
    "    print(i)\n",
    "    print(\"{:.4f}\".format(x))\n",
    "    print(\"{:.8f}\".format(x_2))"
   ]
